# Kopieer naar .env.local (lokaal) of zet deze waarden in Vercel > Settings > Environment Variables.
# Echte waarden NOOIT in de repository zetten: de repository is openbaar.

# Supabase-project "Partijhandel". Alleen de server van de site gebruikt deze waarden.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable of anon sleutel uit Supabase > Project Settings > API>

# Gedeelde sleutel tussen de site en de database (formulieren inleveren, meldingen ophalen).
# Staat in het Salesbureau: Website > Site-beheer > "Toon de sleutel".
WEBSITE_FORM_SECRET=

# Cloudflare Turnstile (spamcontrole). Lokaal testen kan met de testsleutels van Cloudflare:
# site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Publiek webadres van de site, zonder slash op het eind
SITE_URL=https://www.fvdwpartijhandel.nl

# Mails vanuit de site (Resend). Alleen nodig als "Mails vanuit de site" in het Salesbureau op Aan staat.
RESEND_API_KEY=
MAIL_FROM="Frank van de Wijgert Partijhandel <info@fvdwpartijhandel.nl>"

# Beveiliging van de cron-route /api/cron/meldingen (Vercel stuurt deze mee als Bearer-token)
CRON_SECRET=
